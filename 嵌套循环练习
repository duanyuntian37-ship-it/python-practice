# 将1-1000之间(含1000)的所有的5的倍数的数字累加起来
total = 0
for i in range(1,1001):
    if i%5 == 0:
        total += i
print(f"1-1000之间(含1000)的所有的5的倍数的数字累加起来的结果是:{total}")


# 统计字符串 "akiwksjakdiklowiqaamnvbamvaxnsjdsjkaakjd" 有多少个 a 和 k
str = "akiwksjakdiklowiqaamnvbamvaxnsjdsjkaakjd"
count_a = 0
count_k = 0
for i in str:
    if i == "a":
        count_a += 1
    elif i == "k":
        count_k += 1
print(f"字符串中有{count_a}个a和{count_k}个k")