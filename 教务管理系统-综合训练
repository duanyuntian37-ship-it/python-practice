# 开发一个教务管理系统，在该系统中可以维护和管理学员的成绩信息，具体需求如下：
system = {}
print("欢迎使用教务管理系统!")  
A = """
# # # # # # # # # # # # # # # # # # # # # # # # # # [菜单] # # # # # # # # # # # # # # # # # # # # # # # # # # #
# 1.添加学生信息  2.修改学生信息  3.删除学生信息  4.查询学生信息  5.列出所有信息  6.统计班级成绩  7.退出系统  #
# # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # 
"""
while True:
    print(f"{A}")
    choice = input("请选择要执行的操作:")
    match choice:
    # 1.添加学生信息：根据提示录入学生姓名、语文、数学、英语成绩，录入完成保存到系统中。
        case "1" :
            name = input("请输入学生姓名:")
            if name in system:
                print("学生已存在,请重新输入!")
            else:
                chinese_score = float(input("请输入语文成绩:"))
                math_score = float(input("请输入数学成绩:"))
                english_score = float(input("请输入英语成绩:"))
                system[name] = {"chinese": chinese_score, "math": math_score, "english": english_score}
                print(f"添加{name}成功")
    # 2.修改学生信息：要求输入要修改的学生姓名，然后再提示输入语文、数学、英语成绩，输入完成后修改学员信息。
        case "2" :
            name = input("请输入学生姓名:")
            if name not in system:
                print("学生不存在,请重新输入!")
            else:
                chinese_score = float(input("请输入修改后的语文成绩:"))
                math_score = float(input("请输入修改后的数学成绩:"))
                english_score = float(input("请输入修改后的英语成绩:"))
                system[name] = {"chinese": chinese_score, "math": math_score, "english": english_score}
                print(f"修改{name}成功,修改后语文成绩为{chinese_score},数学成绩为{math_score},英语成绩为{english_score}")
    # 3.删除学生信息: 要求输入要删除的学生姓名, 根据姓名删除学生信息.
        case "3" :
            name = input("请输入学生姓名:")
            if name not in system:
                print("学生不存在,请重新输入!")
            else:
                del system[name]
                print(f"删除{name}成功")
    # 4.查询学生信息：要求输入要查询的学生姓名，根据姓名查询学生信息并输出。
        case "4" :
            name = input("请输入学生姓名:")
            if name not in system:
                print("学生不存在,请重新输入!")
            else:
                n = system[name]
                print(f"学生{name}的成绩为\n语文成绩{n['chinese']},数学成绩{n['math']},英语成绩{n['english']}")
    # 5.列出所有学生：遍历所有学生信息并输出。
        case "5" :
            for name in system:
                n = system[name]
                print(f"学生信息如下:\n学生姓名:{name}\t语文成绩{n['chinese']}\t数学成绩{n['math']}\t英语成绩{n['english']}")
    # 6.统计班级成绩：统计班级语文、数学、英语成绩的最高分、最低分、平均分，以及语文、数学、英语最高分和最低分的学员姓名。
        case "6" :
            chinese_list = []
            math_list = []
            english_list = []
            for name in system:
                stu = system[name]
                chinese_list.append(stu["chinese"])
                math_list.append(stu["math"])
                english_list.append(stu["english"])
                
            chinese_max = max(chinese_list)
            chinese_min = min(chinese_list)
            chinese_avg = sum(chinese_list) / len(chinese_list)
        
            math_max = max(math_list)
            math_min = min(math_list)
            math_avg = sum(math_list) / len(math_list)
        
            english_max = max(english_list)
            english_min = min(english_list)
            english_avg = sum(english_list) / len(english_list)
        
            # 找最高分、最低分对应的学生姓名
            chinese_max_name = ""
            chinese_min_name = ""
            math_max_name = ""
            math_min_name = ""
            english_max_name = ""
            english_min_name = ""
            for name in system:
                s = system[name]
                if s["chinese"] == chinese_max:
                    chinese_max_name = name
                if s["chinese"] == chinese_min:
                    chinese_min_name = name
                if s["math"] == math_max:
                    math_max_name = name
                if s["math"] == math_min:
                    math_min_name = name
                if s["english"] == english_max:
                    english_max_name = name
                if s["english"] == english_min:
                    english_min_name = name
        
            # 打印输出，:.2f保留两位小数
            print("====班级成绩统计====")
            print(f"语文最高分:{chinese_max}({chinese_max_name}),最低分:{chinese_min}({chinese_min_name}),平均分:{chinese_avg:.2f}")
            print(f"数学最高分:{math_max}({math_max_name}),最低分:{math_min}({math_min_name}),平均分:{math_avg:.2f}")
            print(f"英语最高分:{english_max}({english_max_name}),最低分:{english_min}({english_min_name}),平均分:{english_avg:.2f}")
    # 7.退出系统。
        case "7" :
            print("系统已退出,欢迎再次使用!")
            break
        case _ :
            print("非法输入,请重新输入!")